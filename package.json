  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@dokploy/cli": "0.30.7",
    "axios": "^1.21.1",
    "dotenv": "^18.0.10",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "esbuild": "^0.28.2",
    "esbuild-plugin-license": "^1.2.3",
